{
  "schema_version": "1.0.0",
  "index_id": "pandora-memory-evidence-index",
  "purpose": "Classify every committed Pandora Memory evidence artifact so historical recovery evidence is preserved but can never be mistaken for current provider truth.",
  "immutability_contract": "Entries record the SHA-256 of the artifact as committed. scripts/check_evidence_metadata.mjs fails if a tracked artifact changes without a deliberate index update, which makes silent rewriting of historical evidence a CI failure rather than an invisible edit.",
  "reading_rule": "Only entries with current=true describe present-day state. Every entry with current=false names the evidence_id that replaced it in superseded_by. An artifact being committed is never by itself proof that its contents are still true.",
