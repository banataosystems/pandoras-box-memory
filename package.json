{
  "name": "pandoras-box-memory",
  "version": "0.1.0-recovery",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/verify.mjs --only unit --only behavior --only memory --only gateway --only security",
    "test:unit": "node --test scripts/test/*_test.mjs",
    "test:behavior": "node scripts/test_memory_evidence_intake_behavior.mjs",
    "test:security": "bash scripts/check_no_literal_secrets.sh && node scripts/check_evidence_metadata.mjs --self-test && node scripts/check_branch_protection_contexts.mjs --self-test && node scripts/check_capability_evidence_binding.mjs --self-test",
    "test:gateway": "node scripts/run_gateway_tests.mjs",
    "test:memory": "node scripts/check_memory_evidence_intake.mjs",
    "test:registry": "node scripts/validate_capability_registry.mjs --self-test",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.9",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
